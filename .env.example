# ---------------------------------------------------------------------------
# Credenciales y puertos del stack. Copia este fichero a ".env" y ajústalo.
#   cp .env.example .env
# Docker Compose lee ".env" automáticamente.
# ---------------------------------------------------------------------------

# --- Nombre del proyecto Docker Compose ---
# Identifica contenedores, volumenes y red. Si clonas el repo en OTRA carpeta
# para levantar un segundo stack en la misma maquina, cambia este nombre
# (p. ej. bigdata-stack-2) y usa puertos distintos mas abajo. Asi los dos
# stacks conviven sin chocar.
COMPOSE_PROJECT_NAME=bigdata-stack

# --- MinIO (almacenamiento de objetos compatible con S3) ---
# MinIO archivo su proyecto: ya no publica imagenes oficiales (Docker Hub ni
# Quay) ni binarios. "pgsty/minio" es una rebuild comunitaria del MinIO
# autentico que sigue actualizandose. Alternativas modernas: rustfs/rustfs,
# chrislusf/seaweedfs, dxflrs/garage. El init usa boto3, asi que cualquiera vale.
MINIO_IMAGE=pgsty/minio:latest
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=playas
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (metadatos de Superset) ---
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset
POSTGRES_DB=superset
POSTGRES_PORT=5432

# --- Trino (motor SQL) ---
TRINO_PORT=8080

# --- Superset (BI) ---
# Genera una clave real con: openssl rand -base64 42
SUPERSET_SECRET_KEY=cambia-esta-clave-en-produccion
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_PORT=8088

# Versión base de la imagen de Superset (pínchala para reproducibilidad)
SUPERSET_IMAGE=apache/superset:latest

# --- Agente web (bonus) ---
# Solo se levanta con el perfil "agent":
#   docker compose --profile agent up -d --build agent
AGENT_PORT=8000

# ---------------------------------------------------------------------------
# EJEMPLO: segundo stack en otra carpeta (sin chocar con el primero)
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=bigdata-stack-2
# MINIO_API_PORT=9100
# MINIO_CONSOLE_PORT=9101
# POSTGRES_PORT=5433
# TRINO_PORT=8181
# SUPERSET_PORT=8188
# AGENT_PORT=8100
